{
  "name": "@dookoi/dsh-client-ui-edit-message",
  "version": "0.1.1",
  "description": "DeepSeek Harness 插件：在对话里直接编辑已发送的用户消息，并从该条重新分叉会话。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml"
      ]
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "edit-message"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DooKoi/dsh-plugins.git",
    "directory": "plugins/edit-message"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
